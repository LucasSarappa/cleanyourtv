<?xml version="1.0" encoding="utf-8"?>
<!-- The Now playing card: frosted glass like the pills; focused, a brighter glass with a white rim (never solid
     white, so the title and artist stay readable). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#59FFFFFF" android:endColor="#2EFFFFFF" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
