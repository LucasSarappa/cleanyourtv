<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Appearance panel: icon, title over a hint, the current value and a chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:layout_marginBottom="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/appearance_row_bg"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/apIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/appearance_icon_bg"
        android:duplicateParentState="true"
        android:textColor="@drawable/pill_text"
        android:textSize="16sp"
        android:fontFamily="@font/outfit_medium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/apRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/apRowHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@drawable/pill_text_dim"
            android:duplicateParentState="true"
            android:textSize="11sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

    <TextView
        android:id="@+id/apRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="190dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="13sp"
        android:fontFamily="@font/outfit_medium" />

    <TextView
        android:id="@+id/apChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="20sp" />
</LinearLayout>
