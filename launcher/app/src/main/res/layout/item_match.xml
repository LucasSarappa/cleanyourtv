<?xml version="1.0" encoding="utf-8"?>
<!-- One match in the football list: a thin bar in the competition's colour, then competition and status, the two
     teams with their crests around the score, and the scorers and channel underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:background="@drawable/glass_row_bg"
    android:focusable="true"
    android:clickable="true">

    <View
        android:id="@+id/accent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/match_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:duplicateParentState="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/league"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.16"
                android:textAllCaps="true" />

            <View
                android:id="@+id/dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:duplicateParentState="true"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/homeCrest"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#F2FFFFFF"
                android:duplicateParentState="true"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="#F2FFFFFF"
                android:duplicateParentState="true"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/away"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="end"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#F2FFFFFF"
                android:duplicateParentState="true"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium" />

            <ImageView
                android:id="@+id/awayCrest"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Scorers of each side under its team; gone before kick-off and at 0–0. -->
        <LinearLayout
            android:id="@+id/goals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:duplicateParentState="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/homeGoals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="30dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#99FFFFFF"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit" />

            <View
                android:layout_width="76dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/awayGoals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="30dp"
                android:gravity="end"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#99FFFFFF"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Where to watch it: the apps' icons, then the channel and the apps' names. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/channelIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
