<?xml version="1.0" encoding="utf-8"?>
<!-- The Appearance panel (AppearancePanel): a glass sheet at the right, over Home. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="14dp"
    android:background="@drawable/appearance_panel_bg"
    android:elevation="16dp"
    android:clickable="true">

    <TextView
        android:id="@+id/apKicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="LAUNCHER"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.24" />

    <TextView
        android:id="@+id/apTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:text="Apariencia"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="-0.01" />

    <ScrollView
        android:id="@+id/apScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/apRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/apHintBack"
            style="@style/PanelHint"
            android:text="◀  Cerrar" />

        <TextView
            style="@style/PanelHint"
            android:layout_marginStart="18dp"
            android:text="OK  Elegir" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/apProfile"
            style="@style/PanelHint" />
    </LinearLayout>
</LinearLayout>
