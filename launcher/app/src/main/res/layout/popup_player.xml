<?xml version="1.0" encoding="utf-8"?>
<!-- The player panel under Now playing: artwork, title and artist, a position bar to jump to any moment, and the
     controls (previous, play/pause, next, the song's video on YouTube). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/matches_panel_bg"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/plArt"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:scaleType="centerCrop"
            android:background="@drawable/np_art_bg"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/plTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:fontFamily="@font/outfit_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.gathin.tvhome.EqualizerView
                    android:id="@+id/plEqualizer"
                    android:layout_width="15dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/plArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Position: focused, Left and Right move it 10 s and OK jumps there. -->
    <LinearLayout
        android:id="@+id/plSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/glass_row_bg"
        android:focusable="true">

        <TextView
            android:id="@+id/plNow"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium" />

        <ProgressBar
            android:id="@+id/plBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:max="1000"
            android:progressDrawable="@drawable/volume_progress" />

        <TextView
            android:id="@+id/plTotal"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/plSeekHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="◀ ▶  10 segundos   ·   OK ir a ese momento"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/outfit"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/plPrev"
            style="@style/PlayerButton"
            android:text="⏮" />

        <TextView
            android:id="@+id/plPlay"
            style="@style/PlayerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/plNext"
            style="@style/PlayerButton"
            android:text="⏭" />

        <TextView
            android:id="@+id/plVideo"
            style="@style/PlayerButton"
            android:layout_width="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_medium"
            android:text="▶  Videoclip" />
    </LinearLayout>
</LinearLayout>
